{
  "info": {
    "_postman_id": "5dd65cf0-d878-4aa9-bca8-89eb94ddd75d",
    "name": "HBnB API v1",
    "description": "Import-ready collection generated from the Flask-RESTX Swagger document at /swagger.json and the api/v1 route implementations. It covers all 10 paths and 23 unique operations. Run the collection in order: Setup creates and captures related resource IDs, the resource folders exercise the API, and Cleanup removes the created data.",
    "version": {
      "major": 1,
      "minor": 1,
      "patch": 0
    },
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Returns a successful status', function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
          "});",
          "",
          "pm.test('Returns JSON', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8080/api/v1",
      "type": "string"
    },
    {
      "key": "swagger_url",
      "value": "http://127.0.0.1:8080/swagger.json",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "reviewer_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "amenity_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "place_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "nested_review_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "review_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - Setup (Run First)",
      "description": "Creates the related resources required by the remaining requests and stores their IDs as collection variables.",
      "item": [
        {
          "name": "Create Owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('user_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ada\",\n  \"last_name\": \"Lovelace\",\n  \"email\": \"owner.{{$guid}}@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/users/",
            "description": "POST /api/v1/users/ — creates the place owner and saves the returned ID as user_id."
          }
        },
        {
          "name": "Create Reviewer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('reviewer_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Grace\",\n  \"last_name\": \"Hopper\",\n  \"email\": \"reviewer.{{$guid}}@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/users/",
            "description": "Creates a second user because an owner cannot review their own place."
          }
        },
        {
          "name": "Create Amenity",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('amenity_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wi-Fi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/amenities/",
            "description": "POST /api/v1/amenities/ — saves the returned ID as amenity_id."
          }
        },
        {
          "name": "Create Place",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('place_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Melbourne Apartment\",\n  \"description\": \"Central apartment near the river\",\n  \"price\": 150.0,\n  \"latitude\": -37.8136,\n  \"longitude\": 144.9631,\n  \"owner_id\": \"{{user_id}}\",\n  \"amenity_ids\": [\n    \"{{amenity_id}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/places/",
            "description": "POST /api/v1/places/ — creates a place using the captured owner and amenity IDs."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/users/",
            "description": "GET /api/v1/users/"
          }
        },
        {
          "name": "Get User",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/users/{{user_id}}",
            "description": "GET /api/v1/users/{user_id}"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
