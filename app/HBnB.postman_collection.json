          "name": "Update Place",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Melbourne Apartment\",\n  \"description\": \"Updated central apartment\",\n  \"price\": 175.0,\n  \"amenity_ids\": [\n    \"{{amenity_id}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/places/{{place_id}}",
            "description": "PUT /api/v1/places/{place_id}. Supplying amenity_ids replaces the complete amenity collection."
          }
        },
        {
          "name": "List Reviews for Place",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/places/{{place_id}}/reviews",
            "description": "GET /api/v1/places/{place_id}/reviews"
          }
        },
        {
          "name": "Create Review for Place",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('nested_review_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Great stay and excellent location\",\n  \"rating\": 5,\n  \"user_id\": \"{{reviewer_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/places/{{place_id}}/reviews",
            "description": "POST /api/v1/places/{place_id}/reviews. The place_id is supplied by the URL."
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "List Reviews",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/reviews/",
