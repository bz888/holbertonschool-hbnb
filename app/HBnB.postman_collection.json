{
  "info": {
    "_postman_id": "5dd65cf0-d878-4aa9-bca8-89eb94ddd75d",
    "name": "HBnB API v1 - JWT and Admin Access",
    "description": "Run the folders in order. Before running, seed an administrator matching admin_email/admin_password. Setup logs in that administrator, creates regular users and an amenity with the admin token, logs in the regular users, and creates a place with its owner's token. The remaining folders cover public, authenticated, admin-only, ownership-bypass, and expected rejection flows.",
    "version": {"major": 1, "minor": 2, "patch": 0},
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const statusMatch = pm.info.requestName.match(/^\\[(\\d{3})/);",
          "pm.test('Returns the expected status', function () {",
          "    if (statusMatch) {",
          "        pm.expect(pm.response.code).to.equal(Number(statusMatch[1]));",
          "    } else {",
          "        pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
          "    }",
          "});",
          "",
          "pm.test('Returns JSON', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});",
          "",
          "if (pm.info.requestName.startsWith('[403 Admin]')) {",
          "    pm.test('Returns the admin privilege error', function () {",
          "        pm.expect(pm.response.json()).to.eql({error: 'Admin privileges required'});",
          "    });",
          "}",
          "if (pm.info.requestName.startsWith('[403 Ownership]')) {",
          "    pm.test('Returns the ownership error', function () {",
          "        pm.expect(pm.response.json()).to.eql({error: 'Unauthorized action'});",
          "    });",
          "}",
          "if (pm.info.requestName.startsWith('[400 Duplicate Create]')) {",
          "    pm.test('Returns the duplicate-create email error', function () {",
          "        pm.expect(pm.response.json()).to.eql({error: 'Email already registered'});",
          "    });",
          "}",
          "if (pm.info.requestName.startsWith('[400 Duplicate Update]')) {",
          "    pm.test('Returns the duplicate-update email error', function () {",
          "        pm.expect(pm.response.json()).to.eql({error: 'Email already in use'});",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {"key": "base_url", "value": "http://127.0.0.1:8080/api/v1", "type": "string"},
    {"key": "swagger_url", "value": "http://127.0.0.1:8080/swagger.json", "type": "string"},
    {"key": "admin_email", "value": "admin@example.com", "type": "string"},
    {"key": "admin_password", "value": "admin-password", "type": "string"},
    {"key": "admin_token", "value": "", "type": "string"},
    {"key": "owner_email", "value": "", "type": "string"},
    {"key": "owner_password", "value": "owner-password", "type": "string"},
    {"key": "owner_token", "value": "", "type": "string"},
    {"key": "user_id", "value": "", "type": "string"},
    {"key": "reviewer_email", "value": "", "type": "string"},
    {"key": "reviewer_updated_email", "value": "", "type": "string"},
    {"key": "reviewer_password", "value": "reviewer-password", "type": "string"},
    {"key": "reviewer_token", "value": "", "type": "string"},
    {"key": "reviewer_id", "value": "", "type": "string"},
    {"key": "amenity_id", "value": "", "type": "string"},
    {"key": "place_id", "value": "", "type": "string"},
    {"key": "nested_review_id", "value": "", "type": "string"},
    {"key": "review_id", "value": "", "type": "string"}
  ],
  "item": [
    {
      "name": "00 - Setup (Run First)",
      "description": "Requires an administrator already present in the application's repository. Change admin_email and admin_password if your seed uses different credentials.",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('owner_email', `owner.${runId}@example.com`);",
                  "pm.collectionVariables.set('reviewer_email', `reviewer.${runId}@example.com`);",
                  "pm.collectionVariables.set('reviewer_updated_email', `reviewer.updated.${runId}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('admin_token', pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/auth/login",
            "description": "Authenticates the pre-seeded administrator and stores admin_token."
          }
        },
        {
          "name": "Create Owner as Admin",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "    pm.collectionVariables.set('user_id', pm.response.json().id);", "}"]}}],
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"first_name\": \"Ada\",\n  \"last_name\": \"Lovelace\",\n  \"email\": \"{{owner_email}}\",\n  \"password\": \"{{owner_password}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/users/",
            "description": "Admin-protected POST /users/. Stores user_id."
          }
        },
        {
          "name": "Login Owner",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["if (pm.response.code === 200) {", "    pm.collectionVariables.set('owner_token', pm.response.json().access_token);", "}"]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{owner_email}}\",\n  \"password\": \"{{owner_password}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Create Reviewer as Admin",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "    pm.collectionVariables.set('reviewer_id', pm.response.json().id);", "}"]}}],
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"first_name\": \"Grace\",\n  \"last_name\": \"Hopper\",\n  \"email\": \"{{reviewer_email}}\",\n  \"password\": \"{{reviewer_password}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/users/"
          }
        },
        {
          "name": "Login Reviewer",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["if (pm.response.code === 200) {", "    pm.collectionVariables.set('reviewer_token', pm.response.json().access_token);", "}"]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{reviewer_email}}\",\n  \"password\": \"{{reviewer_password}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Create Amenity as Admin",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "    pm.collectionVariables.set('amenity_id', pm.response.json().id);", "}"]}}],
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Wi-Fi\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/amenities/"
          }
        },
        {
          "name": "Create Place as Owner",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "    pm.collectionVariables.set('place_id', pm.response.json().id);", "}"]}}],
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{owner_token}}", "type": "string"}]},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"title\": \"Melbourne Apartment\",\n  \"description\": \"Central apartment near the river\",\n  \"price\": 150.0,\n  \"latitude\": -37.8136,\n  \"longitude\": 144.9631,\n  \"amenity_ids\": [\"{{amenity_id}}\"]\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/places/",
            "description": "JWT identity determines ownership; owner_id is intentionally omitted."
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Protected Resource as Admin",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]},
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/protected"
          }
        },
        {
          "name": "Protected Resource as Regular User",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{owner_token}}", "type": "string"}]},
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/protected"
          }
        },
        {
          "name": "[401] Protected Resource Without Token",
          "request": {"auth": {"type": "noauth"}, "method": "GET", "header": [], "url": "{{base_url}}/auth/protected"}
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {"name": "List Users", "request": {"method": "GET", "header": [], "url": "{{base_url}}/users/"}},
        {"name": "Get Owner", "request": {"method": "GET", "header": [], "url": "{{base_url}}/users/{{user_id}}"}},
        {"name": "List Reviews Written by Reviewer", "request": {"method": "GET", "header": [], "url": "{{base_url}}/users/{{reviewer_id}}/reviews"}},
        {
          "name": "Update Own User",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{owner_token}}", "type": "string"}]},
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"first_name\": \"Augusta Ada\",\n  \"last_name\": \"Lovelace\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/users/{{user_id}}"
          }
        },
        {
          "name": "Admin Update Reviewer Protected Fields",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]},
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{reviewer_updated_email}}\",\n  \"password\": \"updated-reviewer-password\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/users/{{reviewer_id}}",
            "description": "Admin updates another user's protected email and password fields. The previously issued reviewer JWT remains valid."
          }
        },
        {
          "name": "[401] Create User Without Token",
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"first_name\": \"Blocked\",\n  \"last_name\": \"User\",\n  \"email\": \"blocked.{{$guid}}@example.com\",\n  \"password\": \"test-password\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/users/"
          }
        },
        {
          "name": "[403 Admin] Create User as Regular User",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{owner_token}}", "type": "string"}]},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"first_name\": \"Blocked\",\n  \"last_name\": \"User\",\n  \"email\": \"blocked.{{$guid}}@example.com\",\n  \"password\": \"test-password\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/users/"
          }
        },
        {
          "name": "[403 Admin] Regular User Updates Another User",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{owner_token}}", "type": "string"}]},
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"first_name\": \"Blocked\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/users/{{reviewer_id}}"
          }
        },
        {
          "name": "[403 Admin] Regular User Updates Protected Field",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{owner_token}}", "type": "string"}]},
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"blocked.{{$guid}}@example.com\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/users/{{user_id}}"
          }
        },
        {
          "name": "[400 Duplicate Create] Admin Creates Duplicate Email",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"first_name\": \"Duplicate\",\n  \"last_name\": \"User\",\n  \"email\": \"{{owner_email}}\",\n  \"password\": \"test-password\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/users/"
          }
        },
        {
          "name": "[400 Duplicate Update] Admin Updates to Duplicate Email",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]},
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{owner_email}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/users/{{reviewer_id}}"
          }
        }
      ]
    },
    {
      "name": "Amenities",
      "item": [
        {"name": "List Amenities", "request": {"method": "GET", "header": [], "url": "{{base_url}}/amenities/"}},
        {"name": "Get Amenity", "request": {"method": "GET", "header": [], "url": "{{base_url}}/amenities/{{amenity_id}}"}},
        {
          "name": "Update Amenity as Admin",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]},
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"High-speed Wi-Fi\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/amenities/{{amenity_id}}"
          }
        },
        {
          "name": "[401] Create Amenity Without Token",
          "request": {"auth": {"type": "noauth"}, "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Blocked amenity\"\n}", "options": {"raw": {"language": "json"}}}, "url": "{{base_url}}/amenities/"}
        },
        {
          "name": "[403 Admin] Create Amenity as Regular User",
          "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{owner_token}}", "type": "string"}]}, "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Blocked amenity\"\n}", "options": {"raw": {"language": "json"}}}, "url": "{{base_url}}/amenities/"}
        },
        {
          "name": "[401] Update Amenity Without Token",
          "request": {"auth": {"type": "noauth"}, "method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Blocked update\"\n}", "options": {"raw": {"language": "json"}}}, "url": "{{base_url}}/amenities/{{amenity_id}}"}
        },
        {
          "name": "[403 Admin] Update Amenity as Regular User",
          "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{owner_token}}", "type": "string"}]}, "method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Blocked update\"\n}", "options": {"raw": {"language": "json"}}}, "url": "{{base_url}}/amenities/{{amenity_id}}"}
        }
      ]
    },
    {
      "name": "Places",
      "item": [
        {"name": "List Places", "request": {"method": "GET", "header": [], "url": "{{base_url}}/places/"}},
        {"name": "Get Place", "request": {"method": "GET", "header": [], "url": "{{base_url}}/places/{{place_id}}"}},
        {
          "name": "Update Place as Owner",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{owner_token}}", "type": "string"}]},
