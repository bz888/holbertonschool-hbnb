            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"description\": \"Updated by an administrator\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/places/{{place_id}}"
          }
        },
        {
          "name": "[403 Ownership] Regular User Updates Another User's Place",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{reviewer_token}}", "type": "string"}]},
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"title\": \"Blocked update\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/places/{{place_id}}"
          }
        },
        {"name": "List Reviews for Place", "request": {"method": "GET", "header": [], "url": "{{base_url}}/places/{{place_id}}/reviews"}},
        {
          "name": "Create Nested Review as Reviewer",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "    pm.collectionVariables.set('nested_review_id', pm.response.json().id);", "}"]}}],
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{reviewer_token}}", "type": "string"}]},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"text\": \"Great stay and excellent location\",\n  \"rating\": 5\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/places/{{place_id}}/reviews",
            "description": "JWT identity determines review authorship; user_id is intentionally omitted."
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {"name": "List Reviews", "request": {"method": "GET", "header": [], "url": "{{base_url}}/reviews/"}},
        {
          "name": "Create Review as Admin",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "    pm.collectionVariables.set('review_id', pm.response.json().id);", "}"]}}],
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"text\": \"Comfortable and convenient\",\n  \"rating\": 4,\n  \"place_id\": \"{{place_id}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/reviews/"
          }
        },
        {"name": "Get Review", "request": {"method": "GET", "header": [], "url": "{{base_url}}/reviews/{{review_id}}"}},
        {
          "name": "Update Own Review as Admin",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]},
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"text\": \"Updated review text\",\n  \"rating\": 5\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/reviews/{{review_id}}"
          }
        },
        {
          "name": "Admin Update Review Ownership Bypass",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]},
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"rating\": 4\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/reviews/{{nested_review_id}}"
          }
        },
        {
          "name": "[403 Ownership] Regular User Updates Another User's Review",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{owner_token}}", "type": "string"}]},
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"rating\": 2\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{base_url}}/reviews/{{nested_review_id}}"
          }
        },
        {
          "name": "[403 Ownership] Regular User Deletes Another User's Review",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{owner_token}}", "type": "string"}]},
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/reviews/{{nested_review_id}}"
          }
        }
      ]
    },
    {
      "name": "99 - Cleanup (Run Last)",
      "item": [
