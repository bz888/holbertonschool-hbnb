    },
    {
      "name": "99 - Cleanup (Run Last)",
      "description": "Exercises every DELETE operation after the dependent requests have completed.",
      "item": [
        {
          "name": "Delete Review",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/reviews/{{review_id}}",
            "description": "DELETE /api/v1/reviews/{review_id}"
          }
        },
        {
          "name": "Delete Nested Review",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/reviews/{{nested_review_id}}",
            "description": "Deletes the review created through POST /api/v1/places/{place_id}/reviews."
          }
        },
        {
          "name": "Delete Place",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/places/{{place_id}}",
            "description": "DELETE /api/v1/places/{place_id}"
          }
        },
        {
          "name": "Delete Amenity",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/amenities/{{amenity_id}}",
            "description": "DELETE /api/v1/amenities/{amenity_id}"
          }
        },
        {
          "name": "Delete Owner",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/users/{{user_id}}",
            "description": "DELETE /api/v1/users/{user_id}"
          }
        },
        {
          "name": "Delete Reviewer",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/users/{{reviewer_id}}",
            "description": "Deletes the second user created by the setup workflow."
          }
        }
      ]
    }
  ]
}
