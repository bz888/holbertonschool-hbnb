                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Augusta Ada\",\n  \"last_name\": \"Lovelace\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/users/{{user_id}}",
            "description": "PUT /api/v1/users/{user_id}. Supported fields: first_name, last_name, and email."
          }
        },
        {
          "name": "List Reviews Written by User",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/users/{{reviewer_id}}/reviews",
            "description": "GET /api/v1/users/{user_id}/reviews"
          }
        }
      ]
    },
