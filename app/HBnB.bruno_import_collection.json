{
  "info": {
    "_postman_id": "5dd65cf0-d878-4aa9-bca8-89eb94ddd75d",
    "name": "HBnB API v1 - Bruno Import",
    "description": "Bruno-ready import of the HBnB API v1 collection. All request scripts use Bruno's scripting APIs. Import this JSON into Bruno, select the Local environment, then run the setup folder in order.",
    "version": {
      "major": 1,
      "minor": 2,
      "patch": 0
    },
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const statusMatch = req.getName().match(/^\\[(\\d{3})/);",
          "const expectedStatus = statusMatch ? Number(statusMatch[1]) : null;",
          "",
          "test(\"Returns the expected status\", () => {",
          "  if (expectedStatus !== null) {",
          "    expect(res.getStatus()).to.equal(expectedStatus);",
          "  } else {",
          "    expect(res.getStatus()).to.be.oneOf([200, 201]);",
          "  }",
          "});",
          "",
          "test(\"Returns JSON\", () => {",
          "  expect(res.getHeader(\"content-type\") || \"\").to.include(\"application/json\");",
          "});",
          "",
          "const body = res.getBody();",
          "",
          "if (req.getName().startsWith(\"[403 Admin]\")) {",
          "  test(\"Returns the admin privilege error\", () => {",
          "    expect(body).to.eql({ error: \"Admin privileges required\" });",
          "  });",
          "}",
          "",
          "if (req.getName().startsWith(\"[403 Ownership]\")) {",
          "  test(\"Returns the ownership error\", () => {",
          "    expect(body).to.eql({ error: \"Unauthorized action\" });",
          "  });",
          "}",
          "",
          "if (req.getName().startsWith(\"[400 Duplicate Create]\")) {",
          "  test(\"Returns the duplicate-create email error\", () => {",
          "    expect(body).to.eql({ error: \"Email already registered\" });",
          "  });",
          "}",
          "",
          "if (req.getName().startsWith(\"[400 Duplicate Update]\")) {",
          "  test(\"Returns the duplicate-update email error\", () => {",
          "    expect(body).to.eql({ error: \"Email already in use\" });",
          "  });",
          "}"
        ]
      }
    }
  ],
