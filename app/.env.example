# Copy this file to .env and replace every placeholder before starting the stack.
# Keep .env private; these values are injected into the containers.
# MYSQL_* values are only required by docker-compose.prod.yml.
MYSQL_DATABASE=hbnb
MYSQL_USER=hbnb
MYSQL_PASSWORD=replace-with-a-url-safe-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password
