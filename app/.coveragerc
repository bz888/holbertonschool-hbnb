[run]
branch = True
relative_files = True
source =
    api
    models
    persistence
    services
    utils
    validators
omit =
    tests/*
    .venv/*
    run.py

[report]
show_missing = True
skip_covered = False
skip_empty = False
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
